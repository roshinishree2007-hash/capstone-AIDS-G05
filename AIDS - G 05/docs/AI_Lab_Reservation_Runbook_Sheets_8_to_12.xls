<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Bottom"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#1F4E79" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/>
   </Borders>
  </Style>
  <Style ss:ID="TitleStyle">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="14" ss:Color="#1F4E79" ss:Bold="1"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="SubTitleStyle">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#595959" ss:Italic="1"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="DataCell">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="DataCellBold">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Bold="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
   <Alignment ss:Vertical="Center"/>
  </Style>
 </Styles>

 <!-- ================================================================= -->
 <!-- SHEET 8: REQUIREMENTS & RUNBOOK DATA                              -->
 <!-- ================================================================= -->
 <Worksheet ss:Name="Sheet 8 - Requirements">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="160"/>
   <Column ss:Width="280"/>
   <Column ss:Width="280"/>

   <Row ss:Height="28">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">RUNBOOK SHEET 8: REQUIREMENTS &amp; STAKEHOLDERS</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="SubTitleStyle"><Data ss:Type="String">AI Lab GPU &amp; Workstation Time-Slot Reservation System</Data></Cell>
   </Row>
   <Row/>

   <!-- Personas Table -->
   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Persona Attribute</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Persona 1: AI / Research Student</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Persona 2: AI Lab Assistant</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Primary Role</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">2nd-4th Year AI &amp; Data Science Student</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lab Assistant / Laboratory Administrator</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Primary Goals</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Reserve GPU workstation for model training. 2. Select 2-hr time-slot. 3. Prevent conflicts.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">1. Monitor 20 workstations. 2. Check in students. 3. Release completed sessions. 4. Manage maintenance.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Key Frustrations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Resource contention, double bookings, zero live availability visibility.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Manual paper tracking, no-shows holding idle GPUs, overlapping reservations.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Technical Savviness</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Medium to High (PyTorch, CUDA, HuggingFace)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Medium (Lab administration, workstation hardware)</Data></Cell>
   </Row>

   <Row/>
   <!-- User Stories Table -->
   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Story ID</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">User Role &amp; Feature</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Business Benefit</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-01</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Student, I want to view live workstation availability</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that I can identify available GPUs without wandering the lab.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-02</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Student, I want to inspect GPU specifications (VRAM, CPU, RAM)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that I choose hardware adequate for my model architecture.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-03</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Student, I want to reserve a workstation for a time slot</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that I have guaranteed compute time for my deep learning tasks.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-04</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Student, I want the system to limit slots to 2 hours</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that compute resources are distributed fairly.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-05</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Student, I want the system to reject overlapping time slots</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that double bookings are physically impossible.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">US-06</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">As a Lab Assistant, I want to check in students and release workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">So that physical attendance is recorded and idle GPUs are freed.</Data></Cell>
   </Row>

   <Row/>
   <!-- MoSCoW Feature Matrix -->
   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">MoSCoW Category</Data></Cell>
    <Cell ss:StyleID="HeaderStyle" ss:MergeAcross="1"><Data ss:Type="String">Included Deliverables</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Must Have</Data></Cell>
    <Cell ss:StyleID="DataCell" ss:MergeAcross="1"><Data ss:Type="String">Student reservation, workstation availability grid, 2-hr max duration, atomic conflict prevention, lab assistant check-in/release, REST API, MySQL 8.0 persistence.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Should Have</Data></Cell>
    <Cell ss:StyleID="DataCell" ss:MergeAcross="1"><Data ss:Type="String">Reservation history queue, search/filter by GPU, dashboard KPI statistics, status indicator badges.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Could Have</Data></Cell>
    <Cell ss:StyleID="DataCell" ss:MergeAcross="1"><Data ss:Type="String">Automated waitlist queue, hardware telemetry metrics (VRAM temp), email notifications.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Won't Have</Data></Cell>
    <Cell ss:StyleID="DataCell" ss:MergeAcross="1"><Data ss:Type="String">Commercial payment gateways, external cloud GPU provisioning, social media authentication.</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ================================================================= -->
 <!-- SHEET 9: ARCHITECTURE SPECIFICATION                               -->
 <!-- ================================================================= -->
 <Worksheet ss:Name="Sheet 9 - Architecture">
  <Table ss:DefaultColumnWidth="140" ss:DefaultRowHeight="20">
   <Column ss:Width="160"/>
   <Column ss:Width="200"/>
   <Column ss:Width="180"/>
   <Column ss:Width="260"/>

   <Row ss:Height="28">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">RUNBOOK SHEET 9: 3-TIER ARCHITECTURE SPECIFICATION</Data></Cell>
   </Row>
   <Row/>

   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Architecture Tier</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Technologies Used</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Default Port / Host</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tier Responsibilities</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Tier 1: Presentation Layer</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HTML5, CSS3, Bootstrap 5, Vanilla JS, Fetch API</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">http://localhost:5500</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Workstation grid, dedicated reservation studio, active queue, lab assistant desk, client validation, mobile responsiveness.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Tier 2: Application Layer</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Java 17+, Spring Boot 3.2, Spring Web, Spring Data JPA</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">http://localhost:8080</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">REST endpoints, 10 business rules enforcement, conflict detection, transaction management, global JSON exception advice.</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">Tier 3: Data Tier</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">MySQL 8.0, InnoDB Storage Engine</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">localhost:3306 (ai_lab_reservation)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Normalized tables (students, workstations, lab_bookings), relational constraints, foreign keys, composite indexes.</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ================================================================= -->
 <!-- SHEET 10: DATABASE DESIGN & DATA DICTIONARY                       -->
 <!-- ================================================================= -->
 <Worksheet ss:Name="Sheet 10 - Database Design">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="140"/>
   <Column ss:Width="140"/>
   <Column ss:Width="120"/>
   <Column ss:Width="130"/>
   <Column ss:Width="80"/>
   <Column ss:Width="250"/>

   <Row ss:Height="28">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">RUNBOOK SHEET 10: DATABASE DATA DICTIONARY</Data></Cell>
   </Row>
   <Row/>

   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Table Name</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Column Name</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Data Type</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Key / Constraint</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nullable</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Description</Data></Cell>
   </Row>

   <!-- Students Table -->
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">students</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">id</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BIGINT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PRIMARY KEY (Auto-Inc)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Unique student primary key</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">students</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">roll_number</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VARCHAR(30)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UNIQUE, NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Institutional student roll number</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">students</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">full_name</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VARCHAR(100)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Full name of student</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">students</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">email</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VARCHAR(100)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UNIQUE, NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Institutional college email</Data></Cell>
   </Row>

   <!-- Workstations Table -->
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">id</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BIGINT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PRIMARY KEY (Auto-Inc)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Unique workstation ID</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">workstation_code</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VARCHAR(20)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">UNIQUE, NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Physical workstation tag (e.g. WS-GPU-01)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">gpu_model</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VARCHAR(80)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Installed GPU hardware (e.g. RTX 4090, A100)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">vram_gb</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">INT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VRAM capacity in Gigabytes</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">status</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ENUM</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DEFAULT 'AVAILABLE'</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">AVAILABLE, RESERVED, IN_USE, MAINTENANCE</Data></Cell>
   </Row>

   <!-- Lab Bookings Table -->
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">id</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BIGINT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PRIMARY KEY (Auto-Inc)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Unique reservation ID</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">student_id</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BIGINT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">FOREIGN KEY (students.id)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reserving student ID</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">workstation_id</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">BIGINT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">FOREIGN KEY (workstations.id)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reserved workstation ID</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">booking_date</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DATE</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Scheduled reservation date</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">start_time</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TIME</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Slot start time</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">end_time</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TIME</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">NOT NULL</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Slot end time (max 2 hours)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">lab_bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">status</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">ENUM</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DEFAULT 'CONFIRMED'</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">CONFIRMED, IN_USE, COMPLETED, CANCELLED</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ================================================================= -->
 <!-- SHEET 11: REST API CONTRACT & RULES                               -->
 <!-- ================================================================= -->
 <Worksheet ss:Name="Sheet 11 - REST API">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="80"/>
   <Column ss:Width="220"/>
   <Column ss:Width="250"/>
   <Column ss:Width="100"/>
   <Column ss:Width="120"/>

   <Row ss:Height="28">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">RUNBOOK SHEET 11: REST API CONTRACT</Data></Cell>
   </Row>
   <Row/>

   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Method</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Endpoint URL</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Purpose &amp; Description</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Success Code</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Error Codes</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">GET</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Retrieve all 20 GPU workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">GET</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/workstations/{id}</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Retrieve single workstation specifications</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">404, 500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">GET</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/workstations/available</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Retrieve currently available workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">PUT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/workstations/{id}/status</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lab Assistant updates status (e.g. MAINTENANCE)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400, 404, 500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">POST</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Create new reservation (enforces 10 business rules)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">201 Created</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400, 404, 409</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">GET</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Retrieve all reservations ordered by date/time</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">PUT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/bookings/{id}/checkin</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lab Assistant marks student check-in (IN_USE)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400, 404, 500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">PUT</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/bookings/{id}/release</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Lab Assistant releases workstation (COMPLETED &gt; AVAILABLE)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400, 404, 500</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="String">DELETE</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">/api/bookings/{id}</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cancel reservation and free workstation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400, 404, 500</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ================================================================= -->
 <!-- SHEET 12: TESTING & POSTMAN RUNBOOK                               -->
 <!-- ================================================================= -->
 <Worksheet ss:Name="Sheet 12 - Testing">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="60"/>
   <Column ss:Width="200"/>
   <Column ss:Width="220"/>
   <Column ss:Width="100"/>
   <Column ss:Width="260"/>

   <Row ss:Height="28">
    <Cell ss:StyleID="TitleStyle"><Data ss:Type="String">RUNBOOK SHEET 12: TEST SCENARIOS &amp; POSTMAN</Data></Cell>
   </Row>
   <Row/>

   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Test #</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Test Scenario</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Target Endpoint</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Expected Code</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Expected Assertion / Output</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">View all workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GET /api/workstations</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Returns array of 20 workstation records</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">View one workstation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GET /api/workstations/1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Returns Workstation Alpha 1 specs</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Create valid 2-hr booking</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">201 Created</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Status CONFIRMED, booking ID generated</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject missing student info</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400 Bad Request</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">VALIDATION_FAILED: rollNumber/email required</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject start &gt;= end time</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400 Bad Request</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Start time must be strictly before end time</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject duration &gt; 2 hours</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">400 Bad Request</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Duration exceeds maximum limit of 2 hours</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject overlapping slot</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">409 Conflict</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Workstation already reserved for time slot</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reject 2nd active booking/day</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">POST /api/bookings</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">409 Conflict</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Student already has active booking on date</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Assistant check-in</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PUT /api/bookings/{id}/checkin</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Booking and workstation set to IN_USE</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Assistant release GPU</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">PUT /api/bookings/{id}/release</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Booking COMPLETED, workstation AVAILABLE</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cancel reservation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">DELETE /api/bookings/{id}</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">200 OK</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Booking CANCELLED, workstation freed</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">12</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Handle invalid workstation</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GET /api/workstations/9999</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">404 Not Found</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Workstation not found with ID 9999</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCellBold"><Data ss:Type="Number">13</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Handle invalid booking</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">GET /api/bookings/9999</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">404 Not Found</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Reservation not found with ID 9999</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
</Workbook>
